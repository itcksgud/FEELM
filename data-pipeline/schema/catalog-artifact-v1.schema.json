{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelm.local/schemas/catalog-artifact-v1.schema.json",
  "title": "FEELM catalog artifact JSONL line v1",
  "description": "Validate each JSONL line independently. The first line must match artifactHeader; subsequent lines must match a record envelope.",
  "oneOf": [
    { "$ref": "#/$defs/artifactHeader" },
    { "$ref": "#/$defs/movieIdentity" },
    { "$ref": "#/$defs/movieProjection" },
    { "$ref": "#/$defs/localization" },
    { "$ref": "#/$defs/genre" },
    { "$ref": "#/$defs/country" },
    { "$ref": "#/$defs/credit" },
    { "$ref": "#/$defs/provider" },
    { "$ref": "#/$defs/availabilitySnapshot" },
    { "$ref": "#/$defs/ottOffer" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" },
    "nullableString": { "type": ["string", "null"] },
    "nullableDateTime": { "type": ["string", "null"], "format": "date-time" },
    "artifactHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "schemaVersion", "catalogVersion", "generatedAt", "sourceChecksums", "sources"],
      "properties": {
        "recordType": { "const": "artifactHeader" },
        "schemaVersion": { "const": 1 },
        "catalogVersion": { "type": "string", "minLength": 1 },
        "generatedAt": { "$ref": "#/$defs/dateTime" },
        "sourceChecksums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movielensArchiveSha256"],
          "properties": { "movielensArchiveSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "object" }
        }
      }
    },
    "externalId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "externalId", "verificationStatus", "verifiedAt"],
      "properties": {
        "source": { "enum": ["MOVIELENS", "TMDB", "IMDB", "WIKIDATA"] },
        "externalId": { "type": "string", "minLength": 1 },
        "verificationStatus": { "enum": ["VERIFIED", "RECOVERED", "UNVERIFIED"] },
        "verifiedAt": { "$ref": "#/$defs/nullableDateTime" }
      }
    },
    "movieIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "movieIdentity" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "createdAt", "identityStatus", "externalIds", "provenance"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "createdAt": { "$ref": "#/$defs/dateTime" },
            "identityStatus": { "enum": ["IDENTITY_VERIFIED", "TYPE_MISMATCH_TV", "TMDB_NOT_FOUND", "IDENTITY_REVIEW_REQUIRED", "SOURCE_REMOVED"] },
            "externalIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/externalId" } },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["movielensTitle", "movielensReleaseYear", "resolutionMethod", "previousTmdbId"],
              "properties": {
                "movielensTitle": { "type": "string", "minLength": 1 },
                "movielensReleaseYear": { "type": ["integer", "null"] },
                "resolutionMethod": { "type": "string", "minLength": 1 },
                "previousTmdbId": { "type": ["integer", "null"] }
              }
            }
          }
        }
      }
    },
    "movieProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "movieProjection" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "mediaType", "identityStatus", "visibilityStatus", "originalTitle", "originalLanguage", "releaseDate", "runtimeMinutes", "posterPath", "backdropPath", "tmdbVoteAverage", "tmdbVoteCount", "metadataFetchedAt", "deleted"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "mediaType": { "const": "MOVIE" },
            "identityStatus": { "const": "IDENTITY_VERIFIED" },
            "visibilityStatus": { "enum": ["UI_READY", "CATALOG_VISIBLE", "UI_INCOMPLETE"] },
            "originalTitle": { "type": "string", "minLength": 1 },
            "originalLanguage": { "type": "string", "minLength": 1 },
            "releaseDate": { "$ref": "#/$defs/nullableString" },
            "runtimeMinutes": { "type": ["integer", "null"], "minimum": 1 },
            "posterPath": { "$ref": "#/$defs/nullableString" },
            "backdropPath": { "$ref": "#/$defs/nullableString" },
            "tmdbVoteAverage": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "tmdbVoteCount": { "type": "integer", "minimum": 0 },
            "metadataFetchedAt": { "$ref": "#/$defs/dateTime" },
            "deleted": { "type": "boolean" }
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "localization" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "locale", "title", "overview", "source", "fetchedAt"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "locale": { "type": "string", "minLength": 2 },
            "title": { "$ref": "#/$defs/nullableString" },
            "overview": { "$ref": "#/$defs/nullableString" },
            "source": { "const": "TMDB" },
            "fetchedAt": { "$ref": "#/$defs/dateTime" }
          }
        }
      }
    },
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "genre" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "code", "displayName", "source", "sourceId", "displayOrder"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "code": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "source": { "enum": ["TMDB", "MOVIELENS"] },
            "sourceId": { "type": "string", "minLength": 1 },
            "displayOrder": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "country" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "countryCode", "displayName", "displayOrder"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "displayName": { "type": "string", "minLength": 1 },
            "displayOrder": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "credit" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movieId", "creditType", "job", "tmdbPersonId", "displayName", "profilePath", "characterName", "creditOrder"],
          "properties": {
            "movieId": { "$ref": "#/$defs/uuid" },
            "creditType": { "enum": ["DIRECTOR", "CAST"] },
            "job": { "type": "string", "minLength": 1 },
            "tmdbPersonId": { "type": "integer", "minimum": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "profilePath": { "$ref": "#/$defs/nullableString" },
            "characterName": { "type": "string" },
            "creditOrder": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "provider" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tmdbProviderId", "providerCode", "displayName", "logoPath", "displayPriority"],
          "properties": {
            "tmdbProviderId": { "type": "integer", "minimum": 1 },
            "providerCode": { "type": "string", "minLength": 1 },
            "displayName": { "type": "string", "minLength": 1 },
            "logoPath": { "$ref": "#/$defs/nullableString" },
            "displayPriority": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "availabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "availabilitySnapshot" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotId", "movieId", "region", "fetchStatus", "source", "aggregatorUrl", "fetchedAt", "freshUntil", "serveUntil", "failureCode"],
          "properties": {
            "snapshotId": { "$ref": "#/$defs/uuid" },
            "movieId": { "$ref": "#/$defs/uuid" },
            "region": { "const": "KR" },
            "fetchStatus": { "enum": ["SUCCESS_LISTED", "SUCCESS_EMPTY", "FAILED"] },
            "source": { "const": "TMDB_JUSTWATCH" },
            "aggregatorUrl": { "$ref": "#/$defs/nullableString" },
            "fetchedAt": { "$ref": "#/$defs/dateTime" },
            "freshUntil": { "$ref": "#/$defs/dateTime" },
            "serveUntil": { "$ref": "#/$defs/dateTime" },
            "failureCode": { "$ref": "#/$defs/nullableString" }
          }
        }
      }
    },
    "ottOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "payload"],
      "properties": {
        "recordType": { "const": "ottOffer" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotId", "movieId", "tmdbProviderId", "monetizationType", "linkType", "landingUrl", "sourceDisplayPriority"],
          "properties": {
            "snapshotId": { "$ref": "#/$defs/uuid" },
            "movieId": { "$ref": "#/$defs/uuid" },
            "tmdbProviderId": { "type": "integer", "minimum": 1 },
            "monetizationType": { "enum": ["FLATRATE", "RENT", "BUY", "FREE", "ADS"] },
            "linkType": { "enum": ["AGGREGATOR", "DIRECT"] },
            "landingUrl": { "$ref": "#/$defs/nullableString" },
            "sourceDisplayPriority": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
