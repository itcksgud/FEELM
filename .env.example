# Copy this file to .env.local and fill in the value locally.
# Never commit the real token.
TMDB_READ_ACCESS_TOKEN=

# Local product profile. These values are examples, not secrets.
POSTGRES_DB=feelm
POSTGRES_USER=feelm
POSTGRES_PASSWORD=feelm_local
DATABASE_URL=jdbc:postgresql://localhost:5432/feelm
DATABASE_USERNAME=feelm
DATABASE_PASSWORD=feelm_local
CATALOG_ARTIFACT_PATH=fixtures/catalog/catalog-c0.jsonl
# Absolute host path used by docker-compose.catalog-import.yml.
CATALOG_ARTIFACT_HOST_PATH=C:/higher/projects/FEELM-standalone/outputs/catalog/catalog.jsonl
AUTH_MODE=fake
FIXED_CLOCK_INSTANT=2026-08-29T12:00:00Z
CURSOR_SIGNING_KEY=local-fixture-cursor-key
# C3/C5/C6 routes remain disabled unless a loopback-only local topology enables them.
# The default Compose stack sets these to true behind same-namespace nginx while
# Spring itself remains bound to 127.0.0.1.
SERVER_ADDRESS=127.0.0.1
C3_ENABLED=false
C3_LOCAL_BIND_ADDRESS=127.0.0.1
C5_LOCAL_ENABLED=false
C5_ARTIFACT_DIRECTORY=
# C6 is an evidence-only local lab. Both Spring and recommender gates must be true.
C6_LOCAL_ENABLED=false
C6_LOCAL_EXPERIMENT_ENABLED=false
# Enables the bounded C1 Rating outbox -> C2 input projection worker.
OUTBOX_WORKER_ENABLED=true
VITE_API_BASE_URL=
# Compile C3/C5/C6 loopback-only routes and C4 Mailpit guidance. Keep false for ordinary production artifacts;
# docker-compose.yml passes true only to its localhost frontend build.
VITE_LOCAL_FEATURES_ENABLED=false
# Local C1 fake-auth adapter only. Never use this value as a real credential.
VITE_C1_FAKE_BEARER_TOKEN=test-c1-owner-token
# C2 fake adapter is local/test-only; an unset mode fails closed.
C2_AUTH_MODE=fake
C2_ARTIFACT_SET_MANIFEST=outputs/c2-serving-fixture/artifact-set.json
# Spring -> recommender local adapter. These public fixtures are accepted only
# when the explicit local fake gate is enabled; default/operational mode is closed.
C2_CANDIDATE_STORE_PATH=/c2-artifacts/candidates/store
C2_RECOMMENDER_BASE_URL=http://recommender:8000
C2_CLIENT_AUTH_MODE=fake
C2_CLIENT_LOCAL_FAKE_ENABLED=true
C2_SERVICE_TOKEN=test-c2-service-token
# REC-EV-007 local-loopback candidate only; production topology has not approved an SLA.
C2_RECOMMENDER_TIMEOUT_MS=750
