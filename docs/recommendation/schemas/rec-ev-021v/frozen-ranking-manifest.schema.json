{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelm.local/schemas/rec-ev-021v/frozen-ranking-manifest.schema.json",
  "title": "REC-EV-021V frozen ranking provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "catalog_source_sha256",
    "rankings_artifact",
    "systems",
    "selected_before_judgments",
    "fit_or_refit_performed",
    "synthetic_fixture"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "catalog_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_before_judgments": {"const": true},
    "fit_or_refit_performed": {"const": false},
    "synthetic_fixture": {"type": "boolean"},
    "rankings_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B7", "B8", "B9"],
      "properties": {
        "B0": {"$ref": "#/$defs/system"},
        "B7": {"$ref": "#/$defs/system"},
        "B8": {"$ref": "#/$defs/system"},
        "B9": {"$ref": "#/$defs/system"}
      }
    }
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "trial_id", "model_revision", "seed"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "trial_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "null"]}
      }
    }
  }
}
