{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feelm.local/schemas/rec-ev-021v/judgment.schema.json",
  "title": "REC-EV-021V deidentified judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "participant_id",
    "blind_item_token",
    "seen_status",
    "viewing_intent",
    "expected_satisfaction",
    "uninterested_reason",
    "actual_watch_14d"
  ],
  "properties": {
    "participant_id": {"type": "string", "pattern": "^p_[0-9a-f]{16}$"},
    "blind_item_token": {"type": "string", "pattern": "^i_[0-9a-f]{20}$"},
    "seen_status": {"enum": ["SEEN", "UNSEEN"]},
    "viewing_intent": {"type": "integer", "minimum": 0, "maximum": 4},
    "expected_satisfaction": {"type": "integer", "minimum": 0, "maximum": 4},
    "uninterested_reason": {
      "enum": [
        "NONE",
        "ALREADY_SEEN",
        "GENRE_MISMATCH",
        "STORY_NOT_APPEALING",
        "CAST_OR_CREW",
        "TOO_UNKNOWN",
        "NOT_IN_MOOD",
        "OTHER_NON_IDENTIFYING"
      ]
    },
    "actual_watch_14d": {"enum": ["YES", "NO", "UNKNOWN", null]},
    "submitted_at_utc": {"type": "string", "format": "date-time"}
  }
}
